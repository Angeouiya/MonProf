{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "competence-ci",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "competence-ci-staging",
      "workers_dev": true,
      "vars": {
        "APP_DEPLOYMENT_PLATFORM": "cloudflare",
        "APP_DEPLOYMENT_ENV": "staging",
        "CLOUDFLARE_ENV": "staging",
        "DATABASE_SCHEMA": "competence"
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "fb4ce95de9d74066823f4ad2ced1276e" }
      ],
      "kv_namespaces": [
        { "binding": "TEACHER_MEDIA_KV", "id": "983a407880f04988a8031ab88e7ebc31" }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "47011", "simple": { "limit": 20, "period": 60 } },
        { "name": "AUTH_BURST_RATE_LIMITER", "namespace_id": "47015", "simple": { "limit": 6, "period": 10 } },
        { "name": "FINANCIAL_RATE_LIMITER", "namespace_id": "47012", "simple": { "limit": 40, "period": 60 } },
        { "name": "FINANCIAL_BURST_RATE_LIMITER", "namespace_id": "47016", "simple": { "limit": 12, "period": 10 } },
        { "name": "API_WRITE_RATE_LIMITER", "namespace_id": "47013", "simple": { "limit": 180, "period": 60 } },
        { "name": "API_WRITE_BURST_RATE_LIMITER", "namespace_id": "47017", "simple": { "limit": 45, "period": 10 } },
        { "name": "API_READ_RATE_LIMITER", "namespace_id": "47021", "simple": { "limit": 300, "period": 60 } },
        { "name": "API_READ_BURST_RATE_LIMITER", "namespace_id": "47022", "simple": { "limit": 75, "period": 10 } },
        { "name": "PUBLIC_READ_RATE_LIMITER", "namespace_id": "47014", "simple": { "limit": 600, "period": 60 } },
        { "name": "PUBLIC_READ_BURST_RATE_LIMITER", "namespace_id": "47018", "simple": { "limit": 120, "period": 10 } },
        { "name": "WEBHOOK_RATE_LIMITER", "namespace_id": "47019", "simple": { "limit": 10000, "period": 60 } },
        { "name": "WEBHOOK_BURST_RATE_LIMITER", "namespace_id": "47020", "simple": { "limit": 2000, "period": 10 } }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "queues": {
        "producers": [
          { "binding": "WEB_PUSH_QUEUE", "queue": "competence-staging-web-push-events" },
          { "binding": "COMMUNICATION_QUEUE", "queue": "competence-staging-communication-campaigns" }
        ],
        "consumers": [
          { "queue": "competence-staging-web-push-events", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 6 },
          { "queue": "competence-staging-communication-campaigns", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 6 }
        ]
      }
    },
    "production": {
      "name": "competence-ci",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "competence.ci/*",
          "zone_id": "3cffe59f4bd21e788c7b72d6c245d665"
        },
        {
          "pattern": "www.competence.ci/*",
          "zone_id": "3cffe59f4bd21e788c7b72d6c245d665"
        }
      ],
      "vars": {
        "APP_DEPLOYMENT_PLATFORM": "cloudflare",
        "APP_DEPLOYMENT_ENV": "production",
        "CLOUDFLARE_ENV": "production",
        "DATABASE_SCHEMA": "competence"
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "fb4ce95de9d74066823f4ad2ced1276e" }
      ],
      "kv_namespaces": [
        { "binding": "TEACHER_MEDIA_KV", "id": "fe54d4b1369f43fc908a380d9e879453" }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "47111", "simple": { "limit": 20, "period": 60 } },
        { "name": "AUTH_BURST_RATE_LIMITER", "namespace_id": "47115", "simple": { "limit": 6, "period": 10 } },
        { "name": "FINANCIAL_RATE_LIMITER", "namespace_id": "47112", "simple": { "limit": 40, "period": 60 } },
        { "name": "FINANCIAL_BURST_RATE_LIMITER", "namespace_id": "47116", "simple": { "limit": 12, "period": 10 } },
        { "name": "API_WRITE_RATE_LIMITER", "namespace_id": "47113", "simple": { "limit": 180, "period": 60 } },
        { "name": "API_WRITE_BURST_RATE_LIMITER", "namespace_id": "47117", "simple": { "limit": 45, "period": 10 } },
        { "name": "API_READ_RATE_LIMITER", "namespace_id": "47121", "simple": { "limit": 300, "period": 60 } },
        { "name": "API_READ_BURST_RATE_LIMITER", "namespace_id": "47122", "simple": { "limit": 75, "period": 10 } },
        { "name": "PUBLIC_READ_RATE_LIMITER", "namespace_id": "47114", "simple": { "limit": 600, "period": 60 } },
        { "name": "PUBLIC_READ_BURST_RATE_LIMITER", "namespace_id": "47118", "simple": { "limit": 120, "period": 10 } },
        { "name": "WEBHOOK_RATE_LIMITER", "namespace_id": "47119", "simple": { "limit": 10000, "period": 60 } },
        { "name": "WEBHOOK_BURST_RATE_LIMITER", "namespace_id": "47120", "simple": { "limit": 2000, "period": 10 } }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "queues": {
        "producers": [
          { "binding": "WEB_PUSH_QUEUE", "queue": "competence-web-push-events" },
          { "binding": "COMMUNICATION_QUEUE", "queue": "competence-communication-campaigns" }
        ],
        "consumers": [
          { "queue": "competence-web-push-events", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 6 },
          { "queue": "competence-communication-campaigns", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 6 }
        ]
      }
    }
  }
}
