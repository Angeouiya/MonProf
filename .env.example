# Runtime Vercel / Prisma via le rôle restreint competence_runtime et le pooler transaction mode.
# Preview doit utiliser une base Supabase de test distincte de Production.
# Ajouter pgbouncer=true et connection_limit=1 pour Prisma en environnement serverless.
DATABASE_URL="postgresql://competence_runtime.PROJECT_REF:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&schema=competence"

# Connexion directe réservée au rôle competence_migrator pour les migrations Prisma.
# Ne jamais utiliser ce rôle propriétaire au runtime.
DIRECT_URL="postgresql://competence_migrator.PROJECT_REF:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require&schema=competence"

# Obligatoire en production. Générer une valeur forte, par exemple:
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="https://www.competence.ci"
NEXT_PUBLIC_APP_URL="https://www.competence.ci"

# Runtime Cloudflare. Wrangler définit automatiquement ces trois valeurs dans
# wrangler.jsonc. Ne pas les ajouter au projet Vercel pendant la double exploitation.
APP_DEPLOYMENT_PLATFORM="cloudflare"
APP_DEPLOYMENT_ENV="staging"
CLOUDFLARE_ENV="staging"

# Secret interne entre les consumers Cloudflare Queues et le serveur Next.js.
# Générer une valeur distincte et forte pour staging et production.
CLOUDFLARE_INTERNAL_SECRET="replace-with-a-strong-random-secret"

# Frais Compétence visibles par le client : 300 points de base = 3 %.
# Ils restent distincts des frais de paiement Jèko facturés selon le moyen choisi.
NEXT_PUBLIC_PAYMENT_SERVICE_FEE_RATE_BPS="300"

# Frais de paiement Jèko facturés au client selon le moyen choisi.
# 100 = 1 %, 200 = 2 %. Les montants fixes sont optionnels.
NEXT_PUBLIC_JEKO_CLIENT_FEE_WAVE_BPS="100"
NEXT_PUBLIC_JEKO_CLIENT_FEE_ORANGE_BPS="200"
NEXT_PUBLIC_JEKO_CLIENT_FEE_MTN_BPS="200"
NEXT_PUBLIC_JEKO_CLIENT_FEE_MOOV_BPS="200"
NEXT_PUBLIC_JEKO_CLIENT_FEE_DJAMO_BPS="200"
NEXT_PUBLIC_JEKO_CLIENT_FEE_WAVE_FIXED_XOF="0"
NEXT_PUBLIC_JEKO_CLIENT_FEE_ORANGE_FIXED_XOF="0"
NEXT_PUBLIC_JEKO_CLIENT_FEE_MTN_FIXED_XOF="0"
NEXT_PUBLIC_JEKO_CLIENT_FEE_MOOV_FIXED_XOF="0"
NEXT_PUBLIC_JEKO_CLIENT_FEE_DJAMO_FIXED_XOF="0"

# Jèko Production uniquement. Ne pas cibler ces variables vers Vercel Preview.
# Le runtime les ignore automatiquement quand VERCEL_ENV != production.
# Les montants envoyés à l'API sont en centimes (FCFA × 100).
# Le webhook doit pointer vers https://VOTRE-DOMAINE/api/webhooks/jeko.
JEKO_API_KEY=""
JEKO_API_KEY_ID=""
JEKO_STORE_ID=""
JEKO_WEBHOOK_SECRET=""
JEKO_API_TIMEOUT_MS="8000"

# PayDunya historique (optionnel). Ne jamais préfixer ces clés par NEXT_PUBLIC_.
# Les conserver seulement pour rapprocher d'anciens dossiers encore ouverts.
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="live"
PAYDUNYA_STORE_NAME="Compétence"
PAYDUNYA_STORE_TAGLINE="Formations académiques et professionnelles"
PAYDUNYA_STORE_PHONE=""
PAYDUNYA_STORE_LOGO_URL="https://competence.ci/images/brand/competence-icon.png"

# Scheduler Cloudflare/Vercel ou cron externe. Il protège notamment le retry de
# l'outbox email chiffrée (la clé AES-GCM est dérivée de NEXTAUTH_SECRET).
CRON_SECRET="change-me-cron-secret"

# Notifications Web Push. Générer une seule paire avec web-push puis conserver
# la clé privée uniquement dans le runtime Production (secret serveur).
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:contact@competence.ci"

# Fournisseur des emails de sécurité : valeur obligatoire `gmail` ou `resend`.
# Le payload v3 chiffré fige le fournisseur, l'identité expéditrice et le
# contenu rendu. Resend répète le même JSON et la même Idempotency-Key; Gmail
# répète le même JSON/MIME avec boundary et Message-ID dérivés de la clé du job.
PASSWORD_EMAIL_PROVIDER="gmail"

# Option Gmail API OAuth2, Production uniquement.
# Le compte Gmail doit autoriser l'API Gmail et fournir un refresh token serveur.
# GMAIL_REFRESH_TOKEN ne doit jamais être ciblé vers Vercel Preview.
# Le runtime ignore Gmail automatiquement quand VERCEL_ENV != production.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="diplomateimmobilier99@gmail.com"

# Option Resend, Production uniquement. Le domaine competence.ci doit être
# vérifié (SPF/DKIM) dans Resend. RESEND_API_KEY reste exclusivement serveur.
# Avec PASSWORD_EMAIL_PROVIDER="resend", ces identifiants servent aussi aux
# emails de mot de passe; aucun fallback Gmail/Resend n'a lieu pour ces emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Compétence <notifications@competence.ci>"

# SMS via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
