    "verify:gmail-live": "node scripts/verify-gmail-live.mjs",
    "verify:gmail-live:static": "node --test scripts/verify-gmail-live.test.mjs",
    "verify:public-url": "node -r tsconfig-paths/register ./node_modules/jiti/lib/jiti-cli.mjs scripts/verify-public-url.ts"
